# Shared secret. n8n sends it as `Authorization: Bearer <token>`. Leave empty only for local testing.
API_TOKEN=

# Optional proxy URL for the stealth browser (http://user:pass@host:port). Add when Trustpilot starts
# challenging the server's IP. Same variable name the old GitHub Actions scraper used.
SCRAPER_PROXY=

# How many browser fetches may run at once. Stage 4 fires three band calls per brand in parallel.
# This is what keeps the container inside its memory limit - measured ~430 MiB per Chromium, so
# 3 concurrent peaked at 994 MiB against the 3g cap in docker-compose.yml. Raise both together.
MAX_CONCURRENCY=3

# Per-page browser timeout in milliseconds. Since 2026-09-19 a fetch returns as soon as the page's
# __NEXT_DATA__ blob is attached (~5s), so this is only reached by a page that never yields it - a
# challenge that does not clear - and that page then costs a retry as ScrapeBlocked. Before that
# date the fetch waited for network idle, which Trustpilot never reaches, so most calls sat out
# this whole timeout with the data already in hand: 31s per band call, ~71s per brand. So this
# caps dead time; it is not headroom. Raising it makes the worst case worse. Measured: at 20000
# every call still returned a full 20 reviews. 30000 leaves margin without blowing the budget below.
FETCH_TIMEOUT_MS=30000

# Block images/fonts/CSS/media in the browser. We only read the __NEXT_DATA__ blob out of the
# HTML, so these cost memory and time for nothing. Set false if Trustpilot starts challenging.
BLOCK_RESOURCES=true

# Hard cap on pages per call (20 reviews per page). Budget against Stage 4's 250s per band call:
#   one fetch      = FETCH_TIMEOUT_MS/1000                        = 30s  (observed ~32s)
#   one fetch_page = 2 attempts x 30 + 1 x PAGE_DELAY_S           = 62s
#   one scrape     = MAX_PAGES x 62 + (MAX_PAGES-1) x PAGE_DELAY_S = 190s
# The old version of this sum said 128s. It was wrong twice: it counted one retry for the whole
# call rather than per page, and it missed Scrapling's own undeclared retries=3, which multiplied
# everything above by three for a ~560s worst case. The code now passes retries=1 explicitly.
# Re-do this arithmetic before raising this, FETCH_TIMEOUT_MS or SCRAPE_BUDGET_S - the three only
# make sense together.
MAX_PAGES=3

# Wall-clock ceiling for one call, seconds. This is the number that actually protects Stage 4:
# nothing cancels a request once it starts (Starlette does not cancel handlers on client
# disconnect, and the browser runs in a thread that cannot be cancelled), so a caller that gives
# up does NOT free the browser. Instead the scrape stops starting pages it cannot finish and
# returns the reviews it already has, with the X-Truncated response header set.
# 200 sits between the 190s nominal worst case and Stage 4's 250s: high enough that a healthy
# slow call is never cut short, low enough to leave slack for a single fetch overrunning
# FETCH_TIMEOUT_MS. Keep stop_grace_period in docker-compose.yml above this.
SCRAPE_BUDGET_S=200

# Seconds to wait between pages of the same call and before a retry.
PAGE_DELAY_S=2

# Trustpilot's challenge is CloudFront-based; the Cloudflare solver is not needed. Flip if that changes.
SOLVE_CLOUDFLARE=false

HOST=0.0.0.0
PORT=8000
