# Shared secret. n8n sends it as `Authorization: Bearer <token>`. Leave empty only for local testing.
API_TOKEN=

# Optional proxy URL for the stealth browser (http://user:pass@host:port). Add when Trustpilot starts
# challenging the server's IP. Same variable name the old GitHub Actions scraper used.
SCRAPER_PROXY=

# How many browser fetches may run at once. Stage 4 fires three band calls per brand in parallel.
MAX_CONCURRENCY=3

# Per-page browser timeout in milliseconds. Stage 4 allows 250s per band call.
FETCH_TIMEOUT_MS=60000

# Block images/fonts/CSS/media in the browser. We only read the __NEXT_DATA__ blob out of the
# HTML, so these cost memory and time for nothing. Set false if Trustpilot starts challenging.
BLOCK_RESOURCES=true

# Hard cap on pages per call (20 reviews per page). On a datacenter IP a page takes ~60s, so
# keep MAX_PAGES x FETCH_TIMEOUT_MS inside the 250s Stage 4 allows per band call.
MAX_PAGES=3

# Seconds to wait between pages of the same call and before a retry.
PAGE_DELAY_S=2

# Trustpilot's challenge is CloudFront-based; the Cloudflare solver is not needed. Flip if that changes.
SOLVE_CLOUDFLARE=false

HOST=0.0.0.0
PORT=8000
